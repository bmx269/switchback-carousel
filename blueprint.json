{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Switchback Carousel showcase",
		"description": "Sample posts and events, plus a front page of carousels built with Switchback Carousel and Advanced Query Loop.",
		"author": "bmx269",
		"categories": [ "Blocks" ]
	},
	"landingPage": "/",
	"preferredVersions": {
		"wp": "latest",
		"php": "8.3"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "twentytwentyfive"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/bmx269/switchback-carousel/playground/switchback-carousel.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "advanced-query-loop"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/switchback-demo/images"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/switchback-demo/setup.php",
			"data": {
				"resource": "url",

<?xml version="1.0"?>
<ruleset name="Switchback Carousel">
	<description>WordPress Coding Standards for Switchback Carousel.</description>

	<file>./switchback-carousel.php</file>
	<file>./includes</file>
	<file>./src</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*\.(js|css|scss|json)$</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="testVersion" value="8.0-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress">
		<!-- Class files follow the class-*.php convention; other includes are grouped by concern. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="switchback-carousel"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="switchback_carousel"/>
				<element value="SwitchbackCarousel"/>
			</property>
		</properties>
	</rule>
</ruleset>

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "switchback-carousel/slide",
	"version": "1.0.0",
	"title": "Slide",
	"category": "media",
	"description": "One hand-built slide. Holds any blocks.",
	"parent": [
		"switchback-carousel/track"
	],
	"textdomain": "switchback-carousel",
	"usesContext": [
		"postId",
		"postType"
	],
	"example": {
		"viewportWidth": 400,
		"attributes": {
			"style": {
				"color": {
					"background": "#f3efe6"
				},
				"spacing": {
					"padding": {
						"top": "24px",
						"right": "24px",
						"bottom": "24px",
						"left": "24px"
					}
				},
				"border": {
					"radius": "12px"
				}
			}
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"level": 3,
					"content": "A slide"
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Build it from any blocks."
				}
			}
		]
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"link": true,
			"heading": true,
			"button": true
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textAlign": true,
			"textDecoration": true,
			"textTransform": true,
			"fontStyle": true,
			"fontWeight": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"fontFamily": true
			}
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"__experimentalDefaultControls": {
				"padding": true,
				"blockGap": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"shadow": true,
		"dimensions": {
			"minHeight": true,
			"aspectRatio": true
		},
		"filter": {
			"duotone": true
		},
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"default": {
				"type": "constrained"
			}
		}
	},
	"editorScript": "file:./index.js"
}

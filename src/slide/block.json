{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "switchback-carousel/slide",
	"version": "1.0.0",
	"title": "Slide",
	"category": "media",
	"description": "One slide. In a query carousel, the first slide is the design repeated for every post.",
	"parent": [
		"switchback-carousel/track"
	],
	"textdomain": "switchback-carousel",
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		},
		"shadow": true,
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"default": {
				"type": "constrained"
			}
		}
	},
	"editorScript": "file:./index.js"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "switchback-carousel/carousel",
	"version": "1.0.0",
	"title": "Switchback Carousel",
	"category": "media",
	"description": "A carousel of hand-built slides or posts from a Query Loop. Put controls, headings and other blocks anywhere around the slides.",
	"keywords": [
		"slider",
		"slideshow",
		"carousel",
		"posts",
		"gallery"
	],
	"textdomain": "switchback-carousel",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"overlayControls": {
			"type": "boolean",
			"default": false
		},
		"slideCount": {
			"type": "number",
			"default": 0
		},
		"perPage": {
			"type": "number",
			"default": 1
		},
		"perMove": {
			"type": "number",
			"default": 1
		},
		"loop": {
			"type": "string",
			"default": "none"
		},
		"autoplay": {
			"type": "boolean",
			"default": false
		}
	},
	"providesContext": {
		"switchback-carousel/overlayControls": "overlayControls",
		"switchback-carousel/slideCount": "slideCount",
		"switchback-carousel/perPage": "perPage",
		"switchback-carousel/perMove": "perMove",
		"switchback-carousel/loop": "loop",
		"switchback-carousel/autoplay": "autoplay"
	},
	"example": {
		"attributes": {
			"align": ""
		},
		"viewportWidth": 720,
		"innerBlocks": [
			{
				"name": "switchback-carousel/track",
				"attributes": {
					"align": ""
				},
				"innerBlocks": [
					{
						"name": "switchback-carousel/slide",
						"attributes": {
							"style": {
								"color": {
									"background": "#f3efe6"
								},
								"spacing": {
									"padding": {
										"top": "24px",
										"right": "24px",
										"bottom": "24px",
										"left": "24px"
									}
								},
								"border": {
									"radius": "12px"
								}
							}
						},
						"innerBlocks": [
							{
								"name": "core/heading",
								"attributes": {
									"level": 3,
									"content": "Pick a route"
								}
							},
							{
								"name": "core/paragraph",
								"attributes": {
									"content": "Slides hold any blocks you like."
								}
							}
						]
					},
					{
						"name": "switchback-carousel/slide",
						"attributes": {
							"style": {
								"color": {
									"background": "#e6efe9"
								},
								"spacing": {
									"padding": {
										"top": "24px",
										"right": "24px",
										"bottom": "24px",
										"left": "24px"
									}
								},
								"border": {
									"radius": "12px"
								}
							}
						},
						"innerBlocks": [
							{
								"name": "core/heading",
								"attributes": {
									"level": 3,
									"content": "Check the weather"
								}
							},
							{
								"name": "core/paragraph",
								"attributes": {
									"content": "Or show one slide per post."
								}
							}
						]
					},
					{
						"name": "switchback-carousel/slide",
						"attributes": {
							"style": {
								"color": {
									"background": "#f7e6da"
								},
								"spacing": {
									"padding": {
										"top": "24px",
										"right": "24px",
										"bottom": "24px",
										"left": "24px"
									}
								},
								"border": {
									"radius": "12px"
								}
							}
						},
						"innerBlocks": [
							{
								"name": "core/heading",
								"attributes": {
									"level": 3,
									"content": "Pack light"
								}
							},
							{
								"name": "core/paragraph",
								"attributes": {
									"content": "Controls go anywhere inside."
								}
							}
						]
					}
				]
			},
			{
				"name": "switchback-carousel/controls",
				"attributes": {
					"align": "",
					"control": "arrows",
					"layout": {
						"type": "flex",
						"justifyContent": "right"
					}
				}
			}
		]
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"heading": true,
			"button": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textAlign": true,
			"textDecoration": true,
			"textTransform": true,
			"fontStyle": true,
			"fontWeight": true,
			"writingMode": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"fontFamily": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true,
				"blockGap": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"shadow": true,
		"dimensions": {
			"minHeight": true,
			"aspectRatio": true
		},
		"position": {
			"sticky": true
		},
		"filter": {
			"duotone": true
		},
		"layout": {
			"allowSwitching": false,
			"allowInheriting": true,
			"default": {
				"type": "constrained"
			}
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "switchback-carousel/track",
	"version": "1.0.0",
	"title": "Carousel Track",
	"category": "media",
	"description": "The moving part of a carousel. Holds hand-built slides.",
	"parent": [
		"switchback-carousel/carousel"
	],
	"allowedBlocks": [
		"switchback-carousel/slide"
	],
	"textdomain": "switchback-carousel",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"layout": {
			"type": "object",
			"default": {
				"desktop": {
					"columns": 3,
					"step": 1,
					"peek": 0
				},
				"tablet": {},
				"mobile": {
					"columns": 1,
					"step": 1,
					"peek": 0
				}
			}
		},
		"slideWidth": {
			"type": "object",
			"default": {
				"min": 0,
				"max": 0
			}
		},
		"focus": {
			"type": "string",
			"enum": [
				"start",
				"center"
			],
			"default": "start"
		},
		"motion": {
			"type": "object",
			"default": {
				"transition": "slide",
				"duration": 400,
				"loop": "none",
				"drag": "snap",
				"wheel": false,
				"grabCursor": false
			}
		},
		"autoplay": {
			"type": "object",
			"default": {
				"enabled": false,
				"mode": "interval",
				"interval": 5000,
				"speed": 1,
				"pauseOnHover": true
			}
		},
		"edges": {
			"type": "object",
			"default": {
				"overflow": false,
				"fade": "none"
			}
		},
		"direction": {
			"type": "string",
			"enum": [
				"auto",
				"ltr",
				"rtl"
			],
			"default": "auto"
		},
		"linkedLayout": {
			"type": "boolean",
			"default": false
		},
		"lazyImages": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"reusable": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"blockGap": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
